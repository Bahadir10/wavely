{
  "expo": {
    "name": "Wavely",
    "slug": "wavely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wavely-icon.png",
    "scheme": "wavely",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "bundleIdentifier": "com.bahadir.wavely",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.bahadir.wavely",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#6C3BFF",
        "foregroundImage": "./assets/images/wavely-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/wavely-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C3BFF",
          "image": "./assets/images/wavely-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0D0B14",
            "image": "./assets/images/wavely-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3213e99-f99e-42a1-9e03-f7e8bd49327f"
      }
    }
  }
}
