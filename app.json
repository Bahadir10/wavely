{
  "expo": {
    "name": "Wavely",
    "slug": "wavely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wavely-icon.png",
    "scheme": "wavely",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bahadir.wavely",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.bahadir.wavely",
      "adaptiveIcon": {
        "backgroundColor": "#6C3BFF",
        "foregroundImage": "./assets/images/wavely-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/wavely-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C3BFF",
          "image": "./assets/images/wavely-icon.png",
          "imageWidth": 120,
          "dark": { "backgroundColor": "#0D0B14", "image": "./assets/images/wavely-icon.png" }
        }
      ],
      [
        "expo-audio",
        { "enableBackgroundPlayback": true }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
